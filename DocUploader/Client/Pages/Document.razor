@page "/document"
@inject HttpClient _httpClient
@inject IJSRuntime JS
<h3>Get Documents</h3>

<EditForm Model="requestDocuments" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <label>Request Id</label>
        <InputSelect class="form-select" @bind-Value="requestId">
            @foreach (var request in requests!)
            {
                <option value="@request.RequestId">@request.RequestId</option>
            }
        </InputSelect>

    </div>

    <div class="mb-2">
        <label>Client Id</label>
        <InputSelect class="form-select" @bind-Value="clientId">
            @foreach (var client in clients!)
            {
                <option value="@client.ClientId">@client.ClientId</option>
            }
        </InputSelect>

    </div>

    <div class="mb-2">
        <button class="btn btn-primary">Submit</button>
    </div>
</EditForm>

@if (requestDocuments != null!)
{
    <div class="mt-4 mb-4">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Document Name</th>
                    <th>Document Path</th>

                    <th>RequestId Internal</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var requestDocument in requestDocuments)
                {
                    <tr>
                        <td>@requestDocument.DocumentIdInternal</td>
                        <td>@requestDocument.DocumentsName!.Split("\\")[@requestDocument.DocumentsName.Split("\\").Length-1]</td>
                        <td>@requestDocument.DocumentsPath</td>
                        <td></td>
                        @* <td class="text-end"><button type="button" class="btn btn-sm btn-link" @onclick="(() => DownloadFile(requestDocument.DocumentsName!.Split('\\')[requestDocument.DocumentsName.Split('\\').Length-1]))">Download</button></td> *@
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-link" onclick="downloadFile('@requestDocument.DocumentsName.Split('\\').LastOrDefault()')">Download</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@code {

    private int requestId = 1;
    private int clientId = 1;
    private IEnumerable<ExternalRequestDocument>? requestDocuments = new List<ExternalRequestDocument>();

    private IEnumerable<Request>? requests = new List<Request>();
    private IEnumerable<DocUploader.Shared.Models.Client>? clients = new List<DocUploader.Shared.Models.Client>();

    protected override async Task OnInitializedAsync()
    {
        requests = await _httpClient.GetFromJsonAsync<IEnumerable<Request>>($"api/externals/getrequests")!;
        clients = await _httpClient.GetFromJsonAsync<IEnumerable<DocUploader.Shared.Models.Client>>($"api/externals/getclients");
    }

    private async void OnSubmit()
    {
        Console.WriteLine(requestId);
        requestDocuments = await _httpClient.GetFromJsonAsync<IEnumerable<ExternalRequestDocument>>($"api/externals/documents/{clientId}/{requestId}");
        StateHasChanged();
    }

    [JSInvokable]
    private async void DownloadFile(string fileName)
    {
        //message = "Downloading... Please Wait";

        string encodedString = System.Uri.EscapeDataString(fileName);


        var response = await _httpClient.GetAsync($"/api/Files/downloadFile/{fileName}");
        var content = await response!.Content.ReadAsByteArrayAsync();
        if (content.Length > 0)
        {
            //message = "Success";
            await InvokeAsync(StateHasChanged);
            await JS.InvokeAsync<object>("downloadFile", fileName, content);
           
        }
        else
        {
            //message = "Oops! Download Failed";
            await InvokeAsync(StateHasChanged);
        }
    }
}
